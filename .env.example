# PostgreSQL (shared across all services)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=algotrade
POSTGRES_PORT=5432
POSTGRES_SERVER=db

# Maverick backend
ENVIRONMENT=local
DOMAIN=localhost
FRONTEND_HOST=http://localhost
BACKEND_CORS_ORIGINS=http://localhost
ACTIVE_MODEL=current_base

# FMP API (Collector)
FMP_API_KEY=your_fmp_api_key_here
FMP_API_DELAY_SECONDS=0.35
# Optional symbol override for manual/testing runs. Leave blank in production to
# load all active symbols from market.stocks. Set ALLOW_SYMBOL_SUBSET=true to use it.
SYMBOLS=
ALLOW_SYMBOL_SUBSET=
MARKET_TZ=America/New_York
MARKET_OPEN=04:00
MARKET_CLOSE=21:00
LOG_DIR=./logs

# NIBI HPC (warm-refresh training — Alliance Canada H100)
NIBI_HOST=nibi.sharcnet.ca
NIBI_USER=yournibiuser
NIBI_SCRATCH=/scratch/yournibiuser
NIBI_SSH_KEY=/run/secrets/nibi_ssh_key
NIBI_SSH_KEY_CONTENT=   # paste private key content here to auto-mount in scheduler container
NIBI_ACCOUNT=def-yourpi
NIBI_PARTITION=gpu
NIBI_SIM_DIR=/home/yournibiuser/projects/def-yourpi/test_simulation

# MFA auto-login (used by POST /ops/nibi/relogin + auto_login.py)
# NIBI_PASSWORD is required for headless re-login via the Ops dashboard.
NIBI_PASSWORD=                 # your NIBI SSH password
# NIBI_TOTP_SECRET enables fully headless login (no phone needed).
# Get the Base32 secret from: ccdb.alliancecan.ca → My Account → Multi-factor Authentication → Add TOTP token
# Leave blank to use Duo push instead (user must approve on phone).
NIBI_TOTP_SECRET=              # Base32 TOTP secret from CCDB portal (optional)

# Backend (used by promote_model.sh to trigger cache reload)
BACKEND_URL=http://backend:8000

# Datasets output dir (for prepare_data.py)
DATASETS_DIR=./datasets
