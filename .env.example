# PostgreSQL (shared across all services)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=algotrade
POSTGRES_PORT=5432
POSTGRES_SERVER=db

# Maverick backend
ENVIRONMENT=local
DOMAIN=localhost
FRONTEND_HOST=http://localhost
BACKEND_CORS_ORIGINS=http://localhost
ACTIVE_MODEL=current_base

# FMP API (Collector)
FMP_API_KEY=your_fmp_api_key_here
FMP_API_DELAY_SECONDS=0.35
SYMBOLS=AAPL,AMD,AMZN,BA,MSFT,NVDA,GOOGL,TSLA
MARKET_TZ=America/New_York
MARKET_OPEN=04:00
MARKET_CLOSE=21:00
LOG_DIR=./logs

# NIBI HPC (warm-refresh training — manual until SSH from VPS confirmed)
NIBI_HOST=nibi.sharcnet.ca
NIBI_USER=yournibiuser
NIBI_SCRATCH=/scratch/yournibiuser
NIBI_SSH_KEY=/run/secrets/nibi_ssh_key
NIBI_SSH_KEY_CONTENT=   # paste private key content here to auto-mount in scheduler container
NIBI_ACCOUNT=def-yourpi
NIBI_PARTITION=gpu

# Backend (used by promote_model.sh to trigger cache reload)
BACKEND_URL=http://backend:8000

# Datasets output dir (for prepare_data.py)
DATASETS_DIR=./datasets
